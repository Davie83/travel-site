# ============================================================================
#  Cloudflare Pages 용 헤더 설정
#  이 사이트의 보안 헤더와 캐시 규칙은 전부 이 파일이 정합니다.
#
#  이 파일은 static/ 에 있으므로 빌드할 때 dist/ 로 복사됩니다.
#  Cloudflare Pages 가 dist/_headers 를 읽어 적용합니다.
#  (헤더를 바꾸려면 여기만 고치면 됩니다)
# ============================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 주소에 ?v=<파일해시> 가 붙습니다 (build.js 의 assetVersion).
# 파일이 바뀌면 주소도 바뀌므로, 길게 캐시해도 갱신이 밀리지 않습니다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
